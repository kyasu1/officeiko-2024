# ローカル管理アプリ (資格情報を入れた .env はgitignore対象)
#
# 既定値に任せて空でよいもの: CONTENT_DIR / PORT / TRASH_DIR / MEDIA_DIR
# 起動に必須: RUSTFS_* と R2_* の ENDPOINT / BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY / PUBLIC_BASE
#   (どちらか欠けるとサーバは起動せず、欠けた変数名を出して終了する)
# 投稿時にだけ必要: GMB_* (揃うまで GBP 送信は行わない)

CONTENT_DIR=
PORT=3001
TRASH_DIR=
MEDIA_DIR=

# RustFS (下書きメディア。非公開バケット)
RUSTFS_ENDPOINT=https://rustfs.mf.officeiko.co.jp
RUSTFS_BUCKET=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_REGION=auto
# 記事本文に書き込む下書きURLのベース (必須)。普通は ENDPOINT/BUCKET
RUSTFS_PUBLIC_BASE=https://rustfs.mf.officeiko.co.jp/CHANGE_ME

# R2 (公開メディア)。ACCOUNT_IDを実値に置換
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE=https://image.officeiko.work

# GBP (STANDARD投稿を行う時だけ必要)
GMB_SERVICE_ACCOUNT_EMAIL=
GMB_PRIVATE_KEY=
GMB_USER_EMAIL=
GMB_ACCOUNT_ID=
GMB_LOCATION_ID=
