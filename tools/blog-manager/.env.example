# ローカル管理アプリ (資格情報を入れた .env はgitignore対象)
CONTENT_DIR=
PORT=3001
TRASH_DIR=
MEDIA_DIR=
# RustFS (下書き)
RUSTFS_ENDPOINT=https://rustfs.mf.officeiko.co.jp
RUSTFS_BUCKET=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_REGION=auto
RUSTFS_PUBLIC_BASE=
# R2 (公開)。ACCOUNT_IDを実値に置換
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE=https://image.officeiko.work
# GBP (STANDARD投稿を行う時だけ必要)
GMB_SERVICE_ACCOUNT_EMAIL=
GMB_PRIVATE_KEY=
GMB_USER_EMAIL=
GMB_ACCOUNT_ID=
GMB_LOCATION_ID=
